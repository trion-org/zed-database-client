{
  "formatter": "auto",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "Rust": {
      "formatter": "language_server"
    },
    "JavaScript": {
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2
    },
    "TOML": {
      "tab_size": 2
    }
  },
  "file_scan_exclusions": ["target", "node_modules", ".git"]
}
